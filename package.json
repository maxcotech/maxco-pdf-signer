{
  "name": "pdf-signer",
  "version": "1.0.0",
  "description": "Enterprise-grade PDF digital signature library \u2014 visual stamp + local P12 and remote HSM paths",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.ts",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server/index.js",
    "dev:server": "ts-node server/index.ts",
    "openapi:emit": "ts-node scripts/emit-openapi.ts",
    "openapi:check": "npm run openapi:emit && git diff --exit-code -- docs/openapi.json",
    "openapi:lint": "redocly lint docs/openapi.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "asn1js": "^3.0.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.2.4",
    "sharp": "^0.33.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.49.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.0.0",
    "openapi3-ts": "^4.6.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
