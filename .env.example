# Port the REST API listens on
PORT=3000

# Shared secret required in the x-api-key header on every request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Local signing certificate (Path A). Never commit the actual .p12 file or password.
P12_PATH=./certs/company-signing.p12
P12_PASSWORD=

# Optional overrides
DEFAULT_PLACEHOLDER_SIZE=16384
HSM_TIMEOUT_MS=30000
MAX_UPLOAD_MB=25
