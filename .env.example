# Port the REST API listens on
PORT=3000

# Shared secret required in the x-api-key header on every request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Local signing certificate (Path A). Never commit the actual .p12 file or password.
P12_PATH=./certs/company-signing.p12
P12_PASSWORD=

# Optional overrides
DEFAULT_PLACEHOLDER_SIZE=16384
HSM_TIMEOUT_MS=30000
MAX_UPLOAD_MB=25

# Serve Swagger UI at /docs and the spec at /openapi.json.
# Both are unauthenticated (a browser cannot send x-api-key when loading the UI
# shell), so set this to false on internet-facing deployments.
DOCS_ENABLED=true

# Browser origins allowed to call the API cross-origin (comma-separated, no
# trailing slash — each value is compared literally against the Origin header).
# Non-browser callers send no Origin and are unaffected by this list.
CORS_ORIGINS=http://localhost:3100,https://signsig-business-dev.netlify.app
